# Example configuration. Copy to .env for local development, or better, set
# these in the PHP-FPM pool / systemd unit so they never touch the filesystem.
# Every value is required unless marked optional, and the application refuses
# to start rather than fall back to a default.

# --- Database ---------------------------------------------------------------
PM_DB_HOST=127.0.0.1
PM_DB_NAME=messenger
PM_DB_USERNAME=messenger
# Minimum 32 characters. Generate, do not invent:  openssl rand -base64 36
PM_DB_PASSWORD=replace-me-with-at-least-32-random-characters

# --- Secrets ----------------------------------------------------------------
# Pepper for two-factor backup codes. Minimum 32 characters.
# Changing this invalidates every existing backup code.
PM_BACKUP_CODE_PEPPER=replace-me-with-at-least-32-random-characters

# Encrypts TOTP secrets at rest. If you lose this, every account loses 2FA.
# Back it up separately from the database.
PM_TOTP_ENCRYPTION_KEY=replace-me-with-a-long-random-value

# --- Optional ---------------------------------------------------------------
# ClamAV daemon. Unix socket only; TCP endpoints are deliberately rejected.
# Uploads fail closed when this is unset.
#PM_CLAMD_ENDPOINT=unix:///run/clamav/clamd.sock

# Set to exactly 1 to enable client_message_id send de-duplication. Leave unset
# until migrations/20260808_add_message_idempotency.sql is applied everywhere.
#PM_MESSAGE_IDEMPOTENCY_ENABLED=1
